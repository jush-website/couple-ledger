# 複製這個檔案成 .env.local 並填入實際值。
# 部署到 Vercel 時，同樣的變數要加在專案的 Environment Variables。

# --- Firebase（前端用，會出現在 bundle 裡，這是正常的）---
# 真正的存取控制在 Firestore security rules，不是靠藏這些值。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- NVIDIA NIM（收據辨識，只在 /api/receipt 伺服器端使用，不會進 bundle）---
# 從 https://build.nvidia.com 取得金鑰
NVIDIA_API_KEY=
# 選填：要用哪個 NIM 模型（必須能看圖）。不填就用 api/_nim.js 裡的預設值。
# NIM 模型會定期退役（回 410 Gone），到時候在這裡或 Vercel 換一個就好。
NVIDIA_MODEL=
